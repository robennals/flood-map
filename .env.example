# Copy to .env.local (git-ignored) and fill in to upload map files with `make upload`.
# Create an R2 API token with "Object Read & Write" on your bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address of the bucket (custom domain recommended). The website reads it from web/config.js.
R2_PUBLIC_URL=
